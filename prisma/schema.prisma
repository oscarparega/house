generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum PropertyType {
  APARTMENT
  HOUSE
  LAND
  OTHER
}

enum OperationType {
  SALE
}

enum DecisionStatus {
  NEW
  INTERESTED
  CONTACTED
  VISIT_SCHEDULED
  VISITED
  OFFER_MADE
  REJECTED
  PURCHASED
}

enum FeatureCategory {
  AREA
  EQUIPMENT
  OTHER
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum ImportStatus {
  QUEUED
  FETCHING
  RENDERING
  EXTRACTING
  READY
  FAILED
}

model Property {
  id                  String            @id @default(cuid())
  sourceProvider      String
  sourceUrl           String?           @unique
  sourceListingId     String?
  sourceListingKey    String?
  sourceObservedAt    DateTime
  sourceMetadata      Json
  title               String
  description         String?
  propertyType        PropertyType
  operationType       OperationType     @default(SALE)
  priceAmount         Decimal?          @db.Decimal(14, 2)
  priceCurrency       String?           @db.VarChar(3)
  street              String?
  exteriorNumber      String?
  interiorNumber      String?
  neighborhood        String?
  municipality        String?
  state               String?
  postalCode          String?
  countryCode         String            @default("MX") @db.VarChar(2)
  formattedAddress    String?
  latitude            Decimal?          @db.Decimal(9, 6)
  longitude           Decimal?          @db.Decimal(9, 6)
  landAreaM2          Decimal?          @db.Decimal(10, 2)
  constructionAreaM2  Decimal?          @db.Decimal(10, 2)
  bedrooms            Int?
  bathrooms           Decimal?          @db.Decimal(4, 1)
  parkingSpaces       Int?
  parkingType         String?
  serviceRoom         Boolean?
  propertyAgeYears    Int?
  condition           String?
  orientation         String?
  landUse             String?
  buildingLevels      Int?
  unitFloor           Int?
  maintenanceAmount   Decimal?          @db.Decimal(12, 2)
  maintenanceCurrency String?           @db.VarChar(3)
  technicalSheetQrUrl String?
  agentName           String?
  agentAvatarUrl      String?
  agentPhones         String[]          @default([])
  agentEmail          String?
  officeName          String?
  sourceOfficeId      String?
  decisionStatus      DecisionStatus    @default(NEW)
  isFavorite          Boolean           @default(false)
  rating              Int?
  notes               String?
  visitAt             DateTime?
  rejectionReason     String?
  archivedAt          DateTime?
  publicationStatus   PublicationStatus @default(PUBLISHED)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  images              PropertyImage[]
  features            PropertyFeature[]
  imports             PropertyImport[]

  @@unique([sourceProvider, sourceListingId])
  @@index([decisionStatus])
  @@index([archivedAt])
  @@index([isFavorite])
  @@index([publicationStatus])
}

model PropertyImport {
  id                  String       @id @default(cuid())
  url                 String
  canonicalUrl        String
  status              ImportStatus @default(QUEUED)
  strategy            String?
  provider            String?
  retryCount          Int          @default(0)
  draftData           Json?
  evidence            Json?
  errorMessage        String?
  inputTokens         Int?
  outputTokens        Int?
  firecrawlCredits    Int          @default(0)
  processingStartedAt DateTime?
  completedAt         DateTime?
  propertyId          String?
  property            Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([canonicalUrl])
  @@index([createdAt])
}

model MutationAudit {
  id         String   @id @default(cuid())
  action     String
  targetType String
  targetId   String?
  ipHash     String
  createdAt  DateTime @default(now())

  @@index([ipHash, action, createdAt])
  @@index([action, createdAt])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  alt        String?
  sortOrder  Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, url])
  @@index([propertyId, sortOrder])
}

model PropertyFeature {
  id         String          @id @default(cuid())
  propertyId String
  category   FeatureCategory
  name       String
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, category, name])
  @@index([propertyId])
}
