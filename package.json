{
  "name": "house",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev -H 127.0.0.1",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "worker:imports": "tsx scripts/import-worker.ts",
    "postinstall": "prisma generate",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern src/generated --ignore-pattern public/maplibre",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "csv-parse": "7.0.2",
    "maplibre-gl": "6.6.0",
    "next": "16.3.3",
    "pg": "8.16.3",
    "proj4": "2.21.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shapefile": "0.6.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
